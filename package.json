{
  "name": "agentmanager-vscode",
  "displayName": "Perpetual",
  "description": "Run Codex and Claude Code sessions from VS Code with model switching, handoffs, GitHub repos, and Docker Sandbox support.",
  "version": "0.1.0",
  "publisher": "agentmanager",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Perpetual"
  },
  "homepage": "https://github.com/agentmanager/agentmanager",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentmanager/agentmanager.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/agentmanager/agentmanager/issues"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "agent",
    "codex",
    "claude",
    "claude code",
    "ai",
    "github",
    "docker",
    "handoff"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#101012",
    "theme": "dark"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.99.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:agentmanager.workbench",
    "onCommand:agentmanager.openWorkbench",
    "onCommand:agentmanager.newSession",
    "onCommand:agentmanager.refresh",
    "onCommand:agentmanager.connectLocalRepo",
    "onCommand:agentmanager.connectGithubRepo",
    "onCommand:agentmanager.openNativeClaude",
    "onCommand:agentmanager.openNativeClaudePlan",
    "onCommand:agentmanager.openNativeClaudeAuto",
    "onCommand:agentmanager.openNativeClaudeAcceptEdits",
    "onCommand:agentmanager.openNativeClaudeAgents",
    "onCommand:agentmanager.openNativeClaudeMcp",
    "onCommand:agentmanager.openNativeClaudePlugins",
    "onCommand:agentmanager.openNativeClaudeDiagnostics",
    "onCommand:agentmanager.resumeNativeClaude",
    "onCommand:agentmanager.openNativeCodex",
    "onCommand:agentmanager.resumeNativeCodex",
    "onCommand:agentmanager.forkNativeCodex",
    "onCommand:agentmanager.openNativeCodexCloud",
    "onCommand:agentmanager.openNativeCodexMcp",
    "onCommand:agentmanager.openNativeCodexPlugins",
    "onCommand:agentmanager.openNativeCodexFeatures",
    "onCommand:agentmanager.openNativeCodexDiagnostics",
    "onCommand:agentmanager.openNativeCodexApp"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Perpetual can show its view in Restricted Mode, but repository access, local CLI execution, and Docker Sandbox runs require a trusted workspace.",
      "restrictedConfigurations": [
        "agentmanager.defaultAgent",
        "agentmanager.defaultPermission",
        "agentmanager.defaultExecutionBackend",
        "agentmanager.daemonPath"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentmanager",
          "title": "Perpetual",
          "icon": "media/activity.svg"
        }
      ],
      "panel": [
        {
          "id": "agentmanagerPanel",
          "title": "Perpetual",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agentmanager": [
        {
          "id": "agentmanager.workbench",
          "name": "Perpetual",
          "icon": "media/activity.svg",
          "contextualTitle": "Perpetual",
          "type": "webview"
        }
      ],
      "agentmanagerPanel": [
        {
          "id": "agentmanager.workbench.panel",
          "name": "Perpetual",
          "icon": "media/activity.svg",
          "contextualTitle": "Perpetual",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agentmanager.openWorkbench",
        "title": "Open Perpetual Panel",
        "category": "Perpetual",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentmanager.newSession",
        "title": "New Session",
        "category": "Perpetual",
        "icon": "$(add)"
      },
      {
        "command": "agentmanager.refresh",
        "title": "Refresh",
        "category": "Perpetual",
        "icon": "$(refresh)"
      },
      {
        "command": "agentmanager.connectLocalRepo",
        "title": "Connect Local Repository",
        "category": "Perpetual",
        "icon": "$(repo)"
      },
      {
        "command": "agentmanager.connectGithubRepo",
        "title": "Connect GitHub Repository",
        "category": "Perpetual",
        "icon": "$(github)"
      },
      {
        "command": "agentmanager.openSettings",
        "title": "Open Settings",
        "category": "Perpetual",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentmanager.openNativeClaude",
        "title": "Open Claude Code CLI",
        "category": "Perpetual",
        "icon": "$(terminal)"
      },
      {
        "command": "agentmanager.openNativeClaudePlan",
        "title": "Open Claude Code Plan Mode",
        "category": "Perpetual",
        "icon": "$(list-tree)"
      },
      {
        "command": "agentmanager.openNativeClaudeAuto",
        "title": "Open Claude Code Auto Mode",
        "category": "Perpetual",
        "icon": "$(zap)"
      },
      {
        "command": "agentmanager.openNativeClaudeAcceptEdits",
        "title": "Open Claude Code Accept Edits Mode",
        "category": "Perpetual",
        "icon": "$(check)"
      },
      {
        "command": "agentmanager.openNativeClaudeAgents",
        "title": "Open Claude Code Background Agents",
        "category": "Perpetual",
        "icon": "$(organization)"
      },
      {
        "command": "agentmanager.openNativeClaudeMcp",
        "title": "Open Claude Code MCP Manager",
        "category": "Perpetual",
        "icon": "$(plug)"
      },
      {
        "command": "agentmanager.openNativeClaudePlugins",
        "title": "Open Claude Code Plugins",
        "category": "Perpetual",
        "icon": "$(extensions)"
      },
      {
        "command": "agentmanager.openNativeClaudeDiagnostics",
        "title": "Run Claude Code Doctor",
        "category": "Perpetual",
        "icon": "$(debug-alt)"
      },
      {
        "command": "agentmanager.resumeNativeClaude",
        "title": "Resume Claude Code CLI",
        "category": "Perpetual",
        "icon": "$(history)"
      },
      {
        "command": "agentmanager.openNativeCodex",
        "title": "Open Codex CLI",
        "category": "Perpetual",
        "icon": "$(terminal)"
      },
      {
        "command": "agentmanager.resumeNativeCodex",
        "title": "Resume Codex CLI",
        "category": "Perpetual",
        "icon": "$(history)"
      },
      {
        "command": "agentmanager.forkNativeCodex",
        "title": "Fork Last Codex Session",
        "category": "Perpetual",
        "icon": "$(git-branch)"
      },
      {
        "command": "agentmanager.openNativeCodexCloud",
        "title": "Open Codex Cloud",
        "category": "Perpetual",
        "icon": "$(cloud)"
      },
      {
        "command": "agentmanager.openNativeCodexMcp",
        "title": "Open Codex MCP Manager",
        "category": "Perpetual",
        "icon": "$(plug)"
      },
      {
        "command": "agentmanager.openNativeCodexPlugins",
        "title": "Open Codex Plugins",
        "category": "Perpetual",
        "icon": "$(extensions)"
      },
      {
        "command": "agentmanager.openNativeCodexFeatures",
        "title": "Open Codex Feature Flags",
        "category": "Perpetual",
        "icon": "$(settings)"
      },
      {
        "command": "agentmanager.openNativeCodexDiagnostics",
        "title": "Run Codex Doctor",
        "category": "Perpetual",
        "icon": "$(debug-alt)"
      },
      {
        "command": "agentmanager.openNativeCodexApp",
        "title": "Open Codex App",
        "category": "Perpetual",
        "icon": "$(window)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentmanager.openWorkbench",
          "when": "view == agentmanager.workbench",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agentmanager.openWorkbench"
        },
        {
          "command": "agentmanager.newSession"
        },
        {
          "command": "agentmanager.refresh"
        },
        {
          "command": "agentmanager.connectLocalRepo"
        },
        {
          "command": "agentmanager.connectGithubRepo"
        },
        {
          "command": "agentmanager.openSettings"
        },
        {
          "command": "agentmanager.openNativeClaude"
        },
        {
          "command": "agentmanager.openNativeClaudePlan"
        },
        {
          "command": "agentmanager.openNativeClaudeAuto"
        },
        {
          "command": "agentmanager.openNativeClaudeAcceptEdits"
        },
        {
          "command": "agentmanager.openNativeClaudeAgents"
        },
        {
          "command": "agentmanager.openNativeClaudeMcp"
        },
        {
          "command": "agentmanager.openNativeClaudePlugins"
        },
        {
          "command": "agentmanager.openNativeClaudeDiagnostics"
        },
        {
          "command": "agentmanager.resumeNativeClaude"
        },
        {
          "command": "agentmanager.openNativeCodex"
        },
        {
          "command": "agentmanager.resumeNativeCodex"
        },
        {
          "command": "agentmanager.forkNativeCodex"
        },
        {
          "command": "agentmanager.openNativeCodexCloud"
        },
        {
          "command": "agentmanager.openNativeCodexMcp"
        },
        {
          "command": "agentmanager.openNativeCodexPlugins"
        },
        {
          "command": "agentmanager.openNativeCodexFeatures"
        },
        {
          "command": "agentmanager.openNativeCodexDiagnostics"
        },
        {
          "command": "agentmanager.openNativeCodexApp"
        }
      ]
    },
    "configuration": {
      "title": "Perpetual",
      "properties": {
        "agentmanager.defaultAgent": {
          "type": "string",
          "enum": [
            "claude_code",
            "codex"
          ],
          "default": "claude_code",
          "description": "Default agent for new Perpetual sessions."
        },
        "agentmanager.defaultPermission": {
          "type": "string",
          "enum": [
            "read_only",
            "workspace_write",
            "autonomous"
          ],
          "default": "workspace_write",
          "description": "Default permission mode for new turns."
        },
        "agentmanager.defaultExecutionBackend": {
          "type": "string",
          "enum": [
            "host",
            "docker_sandbox"
          ],
          "default": "host",
          "description": "Default execution backend. Docker Sandbox currently supports Codex only."
        },
        "agentmanager.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Optional model override for new sessions. Empty uses the selected agent CLI default."
        },
        "agentmanager.defaultReasoning": {
          "type": "string",
          "default": "medium",
          "description": "Optional reasoning-effort override for new sessions."
        },
        "agentmanager.defaultLocalProvider": {
          "type": "string",
          "enum": [
            "",
            "ollama",
            "lm_studio"
          ],
          "default": "",
          "description": "Optional local model provider for new Codex sessions. Empty uses cloud/default agent behavior."
        },
        "agentmanager.defaultLocalBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional base URL for the local model provider. Empty uses http://127.0.0.1:11434 for Ollama or http://127.0.0.1:1234 for LM Studio."
        },
        "agentmanager.autoSwitchOnLimit": {
          "type": "boolean",
          "default": true,
          "description": "Switch to another ready agent when the current agent hits a usage limit."
        },
        "agentmanager.switchBackOnRecovery": {
          "type": "boolean",
          "default": true,
          "description": "Switch back to the preferred agent after its usage limit resets."
        },
        "agentmanager.fallbackPriority": {
          "type": "array",
          "default": [
            "claude_code",
            "codex"
          ],
          "items": {
            "type": "string",
            "enum": [
              "claude_code",
              "codex"
            ]
          },
          "description": "Agent fallback order used when the active agent becomes usage-limited or unavailable."
        },
        "agentmanager.resumeWithEarliestAgent": {
          "type": "boolean",
          "default": true,
          "description": "When all agents are limited, resume with the first agent that recovers."
        },
        "agentmanager.unknownLimitRetrySeconds": {
          "type": "number",
          "default": 600,
          "minimum": 0,
          "description": "Retry interval when an agent reports a usage limit without a reset time. Set 0 to wait indefinitely."
        },
        "agentmanager.cloud.autoCarryover": {
          "type": "boolean",
          "default": false,
          "description": "Cloud Continuity: automatically carry active tasks over to the provider's cloud (Claude Code on the web / Codex Cloud) so they keep running when this machine can't."
        },
        "agentmanager.cloud.carryOverOnSleep": {
          "type": "boolean",
          "default": true,
          "description": "Carry running tasks over to the cloud when the machine is about to sleep. Requires auto carryover."
        },
        "agentmanager.cloud.carryOverOnShutdown": {
          "type": "boolean",
          "default": true,
          "description": "Carry running tasks over to the cloud on shutdown or when the daemon stops. Requires auto carryover."
        },
        "agentmanager.cloud.providerStrategy": {
          "type": "string",
          "enum": [
            "same_provider",
            "switch_provider"
          ],
          "enumDescriptions": [
            "Continue in the same provider's cloud (Claude Code sessions go to Claude Code on the web, Codex sessions to Codex Cloud).",
            "Allow switching providers when the current one's cloud isn't ready (e.g. hand a Claude Code task to Codex Cloud)."
          ],
          "default": "same_provider",
          "description": "Which provider's cloud receives a carried-over task."
        },
        "agentmanager.cloud.requireApproval": {
          "type": "boolean",
          "default": false,
          "description": "Ask for approval before work is handed to Codex Cloud or Claude Code on the web."
        },
        "agentmanager.cloud.maxConcurrentRuns": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum number of cloud runs carried over at the same time."
        },
        "agentmanager.cloud.codexEnvId": {
          "type": "string",
          "default": "",
          "description": "Codex Cloud environment id used for carried-over Codex tasks. Create one at chatgpt.com/codex."
        },
        "agentmanager.sandbox.maxConcurrent": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum concurrent Docker Sandbox sessions."
        },
        "agentmanager.sandbox.cpus": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 16,
          "description": "CPU limit for each Docker Sandbox run."
        },
        "agentmanager.sandbox.memory": {
          "type": "string",
          "default": "4g",
          "description": "Memory limit for each Docker Sandbox run."
        },
        "agentmanager.sandbox.networkPreset": {
          "type": "string",
          "enum": [
            "balanced",
            "open",
            "locked_down"
          ],
          "default": "balanced",
          "description": "Network policy preset for Docker Sandbox runs."
        },
        "agentmanager.daemonPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to an am-daemon binary. Empty uses the binary bundled with this extension."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -p tsconfig.json",
    "build:extension": "node scripts/esbuild.mjs --production",
    "build:webview": "vite build --config webview/vite.config.ts",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "node scripts/esbuild.mjs --watch",
    "watch:webview": "vite build --config webview/vite.config.ts --watch",
    "copy-daemon": "node scripts/copy-daemon.mjs",
    "check-daemon": "node scripts/check-daemon.mjs",
    "dev:reload": "node scripts/dev-reload.mjs",
    "dev:sync": "node scripts/dev-reload.mjs --no-reload",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "package:darwin-arm64": "npm run check-daemon -- --target darwin-arm64 && vsce package --target darwin-arm64",
    "package:darwin-x64": "npm run check-daemon -- --target darwin-x64 && vsce package --target darwin-x64",
    "package:linux-x64": "npm run check-daemon -- --target linux-x64 && vsce package --target linux-x64",
    "package:linux-arm64": "npm run check-daemon -- --target linux-arm64 && vsce package --target linux-arm64",
    "package:win32-x64": "npm run check-daemon -- --target win32-x64 && vsce package --target win32-x64",
    "package:win32-arm64": "npm run check-daemon -- --target win32-arm64 && vsce package --target win32-arm64",
    "test:unit": "npm run compile && node --test out/test/*.test.js",
    "test:vscode": "vscode-test --config vscode-test.mjs",
    "test": "npm run test:unit"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.99.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
