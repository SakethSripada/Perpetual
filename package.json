{
  "name": "perpetual-for-vscode",
  "displayName": "Perpetual for VS Code",
  "description": "Run Codex and Claude Code with persistent sessions, account rotation, safe Git worktrees, and review.",
  "version": "0.6.2",
  "publisher": "SakethSripada",
  "license": "MIT",
  "author": {
    "name": "Perpetual"
  },
  "homepage": "https://github.com/SakethSripada/Perpetual",
  "repository": {
    "type": "git",
    "url": "https://github.com/SakethSripada/Perpetual.git"
  },
  "bugs": {
    "url": "https://github.com/SakethSripada/Perpetual/issues"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "agent",
    "codex",
    "claude",
    "claude code",
    "ai",
    "github",
    "docker",
    "handoff",
    "account rotation"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#101012",
    "theme": "dark"
  },
  "preview": false,
  "engines": {
    "vscode": "^1.99.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Perpetual can show its view in Restricted Mode, but repository access, local CLI execution, and Docker Sandbox runs require a trusted workspace.",
      "restrictedConfigurations": [
        "perpetual.defaultAgent",
        "perpetual.defaultPermission",
        "perpetual.defaultExecutionBackend",
        "perpetual.daemonPath"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "perpetual",
          "title": "Perpetual",
          "icon": "media/activity.svg"
        }
      ],
      "panel": [
        {
          "id": "perpetualPanel",
          "title": "Perpetual",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "perpetual": [
        {
          "id": "perpetual.workbench",
          "name": "Perpetual",
          "icon": "media/activity.svg",
          "contextualTitle": "Perpetual",
          "type": "webview"
        }
      ],
      "perpetualPanel": [
        {
          "id": "perpetual.workbench.panel",
          "name": "Perpetual",
          "icon": "media/activity.svg",
          "contextualTitle": "Perpetual",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "perpetual.openWorkbench",
        "title": "Open Perpetual Panel",
        "category": "Perpetual",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "perpetual.newSession",
        "title": "New Session",
        "category": "Perpetual",
        "icon": "$(add)"
      },
      {
        "command": "perpetual.refresh",
        "title": "Refresh",
        "category": "Perpetual",
        "icon": "$(refresh)"
      },
      {
        "command": "perpetual.connectLocalRepo",
        "title": "Connect Local Repository",
        "category": "Perpetual",
        "icon": "$(repo)"
      },
      {
        "command": "perpetual.connectGithubRepo",
        "title": "Connect GitHub Repository",
        "category": "Perpetual",
        "icon": "$(github)"
      },
      {
        "command": "perpetual.openSettings",
        "title": "Open Settings",
        "category": "Perpetual",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "perpetual.openWorkbench",
          "when": "view == perpetual.workbench",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "perpetual.openWorkbench"
        },
        {
          "command": "perpetual.newSession"
        },
        {
          "command": "perpetual.refresh"
        },
        {
          "command": "perpetual.connectLocalRepo"
        },
        {
          "command": "perpetual.connectGithubRepo"
        },
        {
          "command": "perpetual.openSettings"
        }
      ]
    },
    "configuration": {
      "title": "Perpetual",
      "properties": {
        "perpetual.defaultAgent": {
          "type": "string",
          "enum": [
            "claude_code",
            "codex"
          ],
          "default": "claude_code",
          "description": "Default agent for new Perpetual sessions."
        },
        "perpetual.defaultPermission": {
          "type": "string",
          "enum": [
            "read_only",
            "workspace_write",
            "autonomous"
          ],
          "default": "workspace_write",
          "description": "Default permission mode for new turns."
        },
        "perpetual.defaultExecutionBackend": {
          "type": "string",
          "enum": [
            "host",
            "docker_sandbox"
          ],
          "default": "host",
          "description": "Default execution backend. Docker Sandbox currently supports Codex only."
        },
        "perpetual.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Legacy shared model override. Prefer the Claude and Codex profile settings.",
          "markdownDeprecationMessage": "Use `perpetual.claude.model` and `perpetual.codex.model` so provider switches keep deterministic defaults."
        },
        "perpetual.defaultReasoning": {
          "type": "string",
          "default": "medium",
          "description": "Legacy shared reasoning override. Prefer the Claude and Codex profile settings.",
          "markdownDeprecationMessage": "Use `perpetual.claude.reasoning` and `perpetual.codex.reasoning`."
        },
        "perpetual.claude.model": {
          "type": "string",
          "default": "",
          "description": "Claude model or latest-tracking alias used for new Claude runs and automatic switches. Empty uses the Claude Code default."
        },
        "perpetual.claude.reasoning": {
          "type": "string",
          "default": "",
          "description": "Claude effort used for new Claude runs and automatic switches. Empty uses the model default."
        },
        "perpetual.codex.model": {
          "type": "string",
          "default": "",
          "description": "Codex model used for new Codex runs and automatic switches. Empty uses the Codex default."
        },
        "perpetual.codex.reasoning": {
          "type": "string",
          "default": "",
          "description": "Codex reasoning effort used for new Codex runs and automatic switches. Empty uses the model default."
        },
        "perpetual.defaultLocalProvider": {
          "type": "string",
          "enum": [
            "",
            "ollama",
            "lm_studio"
          ],
          "default": "",
          "description": "Optional local model provider for new Codex sessions. Empty uses cloud/default agent behavior."
        },
        "perpetual.defaultLocalBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional base URL for the local model provider. Empty uses http://127.0.0.1:11434 for Ollama or http://127.0.0.1:1234 for LM Studio."
        },
        "perpetual.autoSwitchOnLimit": {
          "type": "boolean",
          "default": true,
          "description": "When the current agent hits a usage limit, continue the task on the other ready agent."
        },
        "perpetual.switchBackOnRecovery": {
          "type": "boolean",
          "default": true,
          "description": "After an automatic agent switch, return to the original agent once it recovers."
        },
        "perpetual.fallbackPriority": {
          "type": "array",
          "default": [
            "claude_code",
            "codex"
          ],
          "items": {
            "type": "string",
            "enum": [
              "claude_code",
              "codex"
            ]
          },
          "description": "Advanced: provider order used only when more than one fallback agent is available. With Claude/Codex, Perpetual skips the limited current agent and uses the other one."
        },
        "perpetual.autoResumeOnLimitReset": {
          "type": "boolean",
          "default": true,
          "description": "Automatically resume paused limit-waiting tasks as soon as the relevant rate limit resets."
        },
        "perpetual.resumeWithEarliestAgent": {
          "type": "boolean",
          "default": true,
          "description": "Legacy name for autoResumeOnLimitReset. Kept for existing installations."
        },
        "perpetual.unknownLimitRetrySeconds": {
          "type": "number",
          "default": 600,
          "minimum": 0,
          "description": "Retry interval when an agent reports a usage limit without a reset time. Set 0 to wait indefinitely."
        },
        "perpetual.local.useFallback": {
          "type": "boolean",
          "default": true,
          "description": "Use selected local models when cloud agents are unavailable."
        },
        "perpetual.local.probeIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "How often to probe cloud/local recovery while waiting."
        },
        "perpetual.local.ollamaBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Ollama base URL for detection and local fallback. Empty uses http://127.0.0.1:11434."
        },
        "perpetual.local.lmStudioBaseUrl": {
          "type": "string",
          "default": "",
          "description": "LM Studio base URL for detection and local fallback. Empty uses http://127.0.0.1:1234."
        },
        "perpetual.sandbox.maxConcurrent": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum concurrent Docker Sandbox sessions."
        },
        "perpetual.sandbox.cpus": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 16,
          "description": "CPU limit for each Docker Sandbox run."
        },
        "perpetual.sandbox.memory": {
          "type": "string",
          "default": "4g",
          "description": "Memory limit for each Docker Sandbox run."
        },
        "perpetual.sandbox.networkPreset": {
          "type": "string",
          "enum": [
            "balanced",
            "open",
            "locked_down"
          ],
          "default": "balanced",
          "description": "Network policy preset for Docker Sandbox runs."
        },
        "perpetual.daemonPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to an am-daemon binary. Empty uses the binary bundled with this extension."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -p tsconfig.json",
    "typecheck:webview": "tsc -p webview/tsconfig.json",
    "build:extension": "node scripts/esbuild.mjs --production",
    "build:webview": "vite build --config webview/vite.config.ts",
    "build": "npm run compile && npm run typecheck:webview && npm run build:extension && npm run build:webview",
    "watch:extension": "node scripts/esbuild.mjs --watch",
    "watch:webview": "vite build --config webview/vite.config.ts --watch",
    "build:daemon": "node scripts/build-daemon.mjs",
    "copy-daemon": "node scripts/copy-daemon.mjs",
    "check-daemon": "node scripts/check-daemon.mjs",
    "audit:rust": "node scripts/audit-rust.mjs",
    "install:local": "node scripts/install-local.mjs",
    "dev:reload": "node scripts/dev-reload.mjs",
    "dev:sync": "node scripts/dev-reload.mjs --no-reload",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --readme-path README.marketplace.md",
    "package:darwin-arm64": "node scripts/package-target.mjs darwin-arm64",
    "package:darwin-x64": "node scripts/package-target.mjs darwin-x64",
    "package:linux-x64": "node scripts/package-target.mjs linux-x64",
    "package:linux-arm64": "node scripts/package-target.mjs linux-arm64",
    "package:win32-x64": "node scripts/package-target.mjs win32-x64",
    "package:win32-arm64": "node scripts/package-target.mjs win32-arm64",
    "test:unit": "npm run compile && node scripts/run-unit-tests.mjs",
    "test:vscode": "vscode-test --config vscode-test.mjs",
    "test": "npm run test:unit && npm run typecheck:webview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.99.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.1"
  }
}
